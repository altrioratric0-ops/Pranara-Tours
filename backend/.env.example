# Supabase URL and Anon Key
# Get these from your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Flask settings
FLASK_ENV=development
FLASK_PORT=5000

# Instagram
INSTAGRAM_PROFILE=pranara_co

# Twilio SMS Notifications Configuration
TWILIO_ACCOUNT_SID=your-twilio-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890

# Comma-separated list of phone numbers to receive notifications
NOTIFICATION_PHONES=+917397532574,+91XXXXXXXXXX
